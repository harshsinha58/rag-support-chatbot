# Copy this file to .env and fill in your values

# --- LLM provider ---
# Choose one: "gemini", "claude", "openai"
LLM_PROVIDER=gemini

GOOGLE_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_claude_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# --- RAG behavior ---
# Cosine similarity threshold below which the bot says "I don't know"
# Lower distance = more similar. FAISS returns L2 distance by default.
# Tune this after testing with your own documents (start around 1.0-1.4).
MAX_RETRIEVAL_DISTANCE=1.3

# Number of chunks to retrieve per query
RETRIEVAL_K=4

# --- Human handoff (optional email alert) ---
ENABLE_EMAIL_HANDOFF=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
HANDOFF_TO_EMAIL=support-team@example.com
